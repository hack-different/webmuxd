{
  "name": "webmuxd",
  "version": "0.9.0",
  "description": "WebUSB implementation of Apple Mobile Device usbmuxd",
  "keywords": [
    "webusb",
    "usbmuxd",
    "usbmux",
    "libimobiledevice",
    "ios",
    "iphone"
  ],
  "homepage": "https://github.com/hack-different/webmuxd#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hack-different/webmuxd"
  },
  "bugs": {
    "url": "https://github.com/hack-different/webmuxd/issues"
  },
  "main": "lib/webmuxd.js",
  "types": "lib/webmuxd.d.ts",
  "files": [
    "lib/**/*",
    "src/remote/transport.proto"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint --ext .ts src/",
    "test": "jest --config jestconfig.json",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "proto": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/remote --ts_proto_opt=esModuleInterop=true,outputServices=false,env=browser,oneof=unions-value,outputJsonMethods=false,outputPartialMethods=false -Isrc/remote src/remote/transport.proto"
  },
  "author": "Rick Mark",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^8.57",
    "eslint-config-prettier": "^9",
    "eslint-plugin-jsdoc": "^48",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "jest": "^29",
    "prettier": "^2.8",
    "ts-jest": "^29",
    "ts-proto": "^2",
    "typescript": "^5.9"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2",
    "@types/w3c-web-usb": "^1.0.10"
  }
}
