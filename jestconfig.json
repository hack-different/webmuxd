{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": [
    "<rootDir>/src"
  ],
  "testRegex": "/__tests__/.*\\.test\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "types": [
            "jest",
            "node",
            "w3c-web-usb"
          ],
          "lib": [
            "es2020",
            "dom"
          ],
          "esModuleInterop": true,
          "skipLibCheck": true,
          "strict": true
        }
      }
    ]
  }
}
